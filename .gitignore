# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase
supabase/.temp
.env.local

# Datos personales generados por el ETL (no publicar)
supabase/seed/

# Artefactos accidentales Windows (redirigir a "nul")
/nul

# Builds de Capacitor (se regeneran con `npx cap sync`)
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/app/release/
/ios/App/build/
/ios/Pods/
/ios/App/Podfile.lock

